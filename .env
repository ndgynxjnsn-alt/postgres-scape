# Names that must be the same across the stack. Compose substitutes them into docker-compose.yaml,
# the sidecar Alloy reads them via sys.env().

# Tenant. Sent by the sidecar Alloy and the app as X-Scope-OrgID (OTLP), by the sidecar as profile label
# "tenant" (graf_zahl/alloy/config.alloy routes profiles by it). The central Alloy passes it on to
# Loki/Mimir/Tempo/Pyroscope. Read by Grafana: graf_zahl/grafana/provisioning/datasources/datasources.yml
# (written there as "fish": change both).
TENANT=fish

# service.name / service_name of PostgreSQL: logs, traces (pg_tracing.otel_service_name), eBPF profiles,
# metrics (job). Search for this in Grafana.
SERVICE_NAME=fish-postgres

# Container name of PostgreSQL. The sidecar's eBPF profiler finds the Postgres processes by it.
PG_CONTAINER=postgresdata
