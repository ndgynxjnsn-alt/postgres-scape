// Grafana Alloy: the stack's single entrypoint, fanning telemetry out to the backends. Clients reach it as
// https://alloy.org through Traefik (TLS, path routing: ../traefik/dynamic.yml), as in the lab (../../lgtm).
//   :4318  OTLP/HTTP (metrics, logs, traces)   -> Mimir / Loki / Tempo, tenant = the sender's X-Scope-OrgID
//   :9999  Pyroscope push API (profiles)       -> Pyroscope, tenant = the profile's "tenant" label
// The backends reject data without a tenant.

// ---------------------------------------------------------------------------
// OTLP
// ---------------------------------------------------------------------------
otelcol.receiver.otlp "default" {
  http {
    endpoint         = "0.0.0.0:4318"
    include_metadata = true   // keep request headers (X-Scope-OrgID) in the context
  }

  output {
    metrics = [otelcol.processor.batch.default.input]
    logs    = [otelcol.processor.batch.default.input]
    traces  = [otelcol.processor.batch.default.input]
  }
}

// Batches per tenant, so the header survives batching
otelcol.processor.batch "default" {
  metadata_keys = ["X-Scope-OrgID"]

  output {
    metrics = [otelcol.exporter.otlphttp.mimir.input]
    logs    = [otelcol.exporter.otlphttp.loki.input]
    traces  = [otelcol.exporter.otlphttp.tempo.input]
  }
}

// Sets X-Scope-OrgID on outgoing requests from the incoming request's header
otelcol.auth.headers "tenant" {
  header {
    key          = "X-Scope-OrgID"
    from_context = "X-Scope-OrgID"
  }
}

otelcol.exporter.otlphttp "tempo" {
  client {
    endpoint = "http://tempo:4318"
    auth     = otelcol.auth.headers.tenant.handler
    tls {
      insecure = true
    }
  }
}

otelcol.exporter.otlphttp "loki" {
  client {
    endpoint = "http://loki:3100/otlp"
    auth     = otelcol.auth.headers.tenant.handler
    tls {
      insecure = true
    }
  }
}

otelcol.exporter.otlphttp "mimir" {
  client {
    endpoint = "http://mimir:9009/otlp"
    auth     = otelcol.auth.headers.tenant.handler
    tls {
      insecure = true
    }
  }
}

// ---------------------------------------------------------------------------
// Profiles. pyroscope.receive_http doesn't forward request headers, so the tenant comes from the profile
// label "tenant" (the sidecar's pyroscope.write sets it). One relabel+write pair per tenant; profiles
// without a known tenant label are dropped.
// ---------------------------------------------------------------------------
pyroscope.receive_http "default" {
  http {
    listen_address = "0.0.0.0"
    listen_port    = 9999
  }
  forward_to = [pyroscope.relabel.fish.receiver]
}

pyroscope.relabel "fish" {
  forward_to = [pyroscope.write.fish.receiver]
  rule {
    source_labels = ["tenant"]
    regex         = "fish"
    action        = "keep"
  }
  rule {
    regex  = "tenant"
    action = "labeldrop"
  }
}

pyroscope.write "fish" {
  endpoint {
    url     = "http://pyroscope:4040"
    headers = { "X-Scope-OrgID" = "fish" }
  }
}
