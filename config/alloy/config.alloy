// Sidecar on the PostgreSQL host. Ships everything to the central Alloy, https://alloy.org (see graf_zahl/):
//   metrics   Postgres, host, custom (custom-metrics.alloy)   OTLP /v1/*, tenant: X-Scope-OrgID header
//   logs      Postgres jsonlog, systemd journal              OTLP /v1/*, tenant: X-Scope-OrgID header
//   traces    pg_tracing                                     OTLP /v1/*, tenant: X-Scope-OrgID header
//   profiles  eBPF                                           Pyroscope push, tenant: label "tenant"
// TENANT, SERVICE_NAME and PG_CONTAINER come from the environment (../../.env).
// Alloy loads every *.alloy file in this directory; components can reference each other across files.

// ---------------- Metrics ----------------
prometheus.exporter.postgres "pg" {
  // options: don't let pg_tracing trace the exporter's own polling queries
  data_source_names  = ["postgresql://postgres:postgres@localhost:5432/postgres?sslmode=disable&options=-c%20pg_tracing.sample_rate%3D0"]
  enabled_collectors = ["stat_statements"]
}

// job becomes service.name in OTLP: the same name as the logs, traces and profiles
discovery.relabel "pg" {
  targets = prometheus.exporter.postgres.pg.targets
  rule {
    target_label = "job"
    replacement  = sys.env("SERVICE_NAME")
  }
}

// Ubuntu host statistics (node_exporter): CPU, memory, disks, filesystems, network, ...
prometheus.exporter.unix "host" {
  procfs_path = "/host/proc"
  sysfs_path  = "/host/sys"
  rootfs_path = "/host"
  enable_collectors = ["systemd"]
}

prometheus.scrape "default" {
  targets         = array.concat(discovery.relabel.pg.output, prometheus.exporter.unix.host.targets)
  scrape_interval = "15s"
  forward_to      = [otelcol.receiver.prometheus.default.receiver]
}

// Prometheus samples -> OTLP, so all signals take the same way to the central Alloy
otelcol.receiver.prometheus "default" {
  output {
    metrics = [otelcol.processor.batch.default.input]
  }
}

// ---------------- Logs: PostgreSQL (jsonlog) ----------------
// Persist read offsets so a restart neither re-sends nor skips lines
otelcol.storage.file "offsets" {
  directory = "/var/lib/alloy/data/filelog"
}

otelcol.receiver.filelog "pg" {
  include  = ["/var/log/postgresql/*.json"]
  start_at = "beginning"
  storage  = otelcol.storage.file.offsets.handler
  output {
    logs = [otelcol.processor.transform.pg.input]
  }
}

otelcol.processor.transform "pg" {
  error_mode = "ignore"

  log_statements {
    context = "resource"
    statements = [
      string.format("set(attributes[\"service.name\"], %q)", sys.env("SERVICE_NAME")),
      `set(attributes["db.system.name"], "postgresql")`,
    ]
  }

  // 1) Raw JSON line -> attributes (original line kept as log.record.original)
  log_statements {
    context    = "log"
    conditions = [`body != nil and Substring(body, 0, 2) == "{\""`]
    statements = [
      `set(attributes["log.record.original"], body)`,
      `merge_maps(attributes, ParseJSON(body), "upsert")`,
    ]
  }

  // 2) Timestamp + severity normalization (OTel Logs Data Model)
  log_statements {
    context = "log"
    statements = [
      `set(time, Time(attributes["timestamp"], "%Y-%m-%d %H:%M:%S.%f %Z")) where attributes["timestamp"] != nil`,
      `set(observed_time, time) where attributes["timestamp"] != nil`,

      `set(severity_text, ToUpperCase(attributes["error_severity"])) where attributes["error_severity"] != nil`,
      `set(severity_number, SEVERITY_NUMBER_DEBUG)  where IsMatch(severity_text, "^DEBUG")`,
      `set(severity_number, SEVERITY_NUMBER_INFO)   where severity_text == "INFO"`,
      `set(severity_number, SEVERITY_NUMBER_INFO2)  where severity_text == "NOTICE"`,
      `set(severity_number, SEVERITY_NUMBER_INFO4)  where severity_text == "LOG"`,
      `set(severity_number, SEVERITY_NUMBER_WARN)   where severity_text == "WARNING"`,
      `set(severity_number, SEVERITY_NUMBER_ERROR)  where severity_text == "ERROR"`,
      `set(severity_number, SEVERITY_NUMBER_FATAL)  where severity_text == "FATAL"`,
      `set(severity_number, SEVERITY_NUMBER_FATAL4) where severity_text == "PANIC"`,
    ]
  }

  // 3) Legacy jsonlog fields -> Semantic Conventions (+ postgresql.* for the rest)
  log_statements {
    context = "log"
    statements = [
      `set(body, attributes["message"]) where attributes["message"] != nil`,

      `set(attributes["user.name"], attributes["user"]) where attributes["user"] != nil`,
      `set(attributes["db.namespace"], attributes["dbname"]) where attributes["dbname"] != nil`,
      `set(attributes["db.query.text"], attributes["statement"]) where attributes["statement"] != nil`,
      `set(attributes["db.response.status_code"], attributes["state_code"]) where attributes["state_code"] != nil`,
      `set(attributes["client.address"], attributes["remote_host"]) where attributes["remote_host"] != nil`,
      `set(attributes["client.port"], Int(attributes["remote_port"])) where attributes["remote_port"] != nil`,
      `set(attributes["process.pid"], Int(attributes["pid"])) where attributes["pid"] != nil`,
      `set(attributes["process.parent_pid"], Int(attributes["leader_pid"])) where attributes["leader_pid"] != nil`,
      `set(attributes["session.id"], attributes["session_id"]) where attributes["session_id"] != nil`,
      `set(attributes["code.function.name"], attributes["func_name"]) where attributes["func_name"] != nil`,
      `set(attributes["code.file.path"], attributes["file_name"]) where attributes["file_name"] != nil`,
      `set(attributes["code.line.number"], Int(attributes["file_line_num"])) where attributes["file_line_num"] != nil`,

      `set(attributes["postgresql.backend_type"], attributes["backend_type"]) where attributes["backend_type"] != nil`,
      `set(attributes["postgresql.application_name"], attributes["application_name"]) where attributes["application_name"] != nil`,
      // query_id is int64; ParseJSON yields float64 and loses precision -> take it from the raw line
      `set(attributes["postgresql.query_id"], ExtractPatterns(attributes["log.record.original"], "\"query_id\":(?P<id>-?[0-9]+)")["id"]) where attributes["query_id"] != nil`,
      `set(attributes["postgresql.txid"], attributes["txid"]) where attributes["txid"] != nil`,
      `set(attributes["postgresql.vxid"], attributes["vxid"]) where attributes["vxid"] != nil`,
      `set(attributes["postgresql.detail"], attributes["detail"]) where attributes["detail"] != nil`,
      `set(attributes["postgresql.hint"], attributes["hint"]) where attributes["hint"] != nil`,
      `set(attributes["postgresql.context"], attributes["context"]) where attributes["context"] != nil`,
      `set(attributes["postgresql.internal_query"], attributes["internal_query"]) where attributes["internal_query"] != nil`,
      `set(attributes["postgresql.line_num"], Int(attributes["line_num"])) where attributes["line_num"] != nil`,
      `set(attributes["postgresql.cursor_position"], Int(attributes["cursor_position"])) where attributes["cursor_position"] != nil`,
      `set(attributes["postgresql.internal_position"], Int(attributes["internal_position"])) where attributes["internal_position"] != nil`,

      `delete_matching_keys(attributes, "^(timestamp|error_severity|message|user|dbname|statement|state_code|remote_host|remote_port|pid|leader_pid|session_id|func_name|file_name|file_line_num|backend_type|application_name|query_id|txid|vxid|detail|hint|context|internal_query|line_num|cursor_position|internal_position|ps|session_start)$")`,
    ]
  }

  output {
    logs = [otelcol.processor.batch.default.input]
  }
}

// ---------------- Logs: systemd journal ----------------
// Everything in journalctl (max. the last 7 h on first start), with the entry's own timestamp.
loki.relabel "journal" {
  forward_to = []
  rule {
    source_labels = ["__journal__systemd_unit"]
    target_label  = "unit"
  }
  rule {
    source_labels = ["__journal_syslog_identifier"]
    target_label  = "syslog_identifier"
  }
  rule {
    source_labels = ["__journal_priority"]
    target_label  = "priority"
  }
  rule {
    source_labels = ["__journal_priority_keyword"]
    target_label  = "priority_keyword"
  }
  rule {
    source_labels = ["__journal__hostname"]
    target_label  = "host"
  }
}

loki.source.journal "host" {
  path          = "/host/var/log/journal"
  relabel_rules = loki.relabel.journal.rules
  forward_to    = [otelcol.receiver.loki.journal.receiver]
}

// Loki entries -> OTLP logs: labels become log attributes, the journal timestamp the record's time
otelcol.receiver.loki "journal" {
  output {
    logs = [otelcol.processor.transform.journal.input]
  }
}

otelcol.processor.transform "journal" {
  error_mode = "ignore"

  log_statements {
    context = "log"
    statements = [
      // service.name: the systemd unit, else the syslog identifier (kernel, sudo, ...)
      `set(attributes["service.name"], attributes["unit"]) where attributes["unit"] != nil`,
      `set(attributes["service.name"], attributes["syslog_identifier"]) where attributes["service.name"] == nil`,
      `set(attributes["host.name"], attributes["host"])`,

      // journald priority (syslog) -> OTel severity
      `set(severity_text, ToUpperCase(attributes["priority_keyword"])) where attributes["priority_keyword"] != nil`,
      `set(severity_number, SEVERITY_NUMBER_FATAL4) where attributes["priority"] == "0"`,
      `set(severity_number, SEVERITY_NUMBER_FATAL3) where attributes["priority"] == "1"`,
      `set(severity_number, SEVERITY_NUMBER_FATAL)  where attributes["priority"] == "2"`,
      `set(severity_number, SEVERITY_NUMBER_ERROR)  where attributes["priority"] == "3"`,
      `set(severity_number, SEVERITY_NUMBER_WARN)   where attributes["priority"] == "4"`,
      `set(severity_number, SEVERITY_NUMBER_INFO2)  where attributes["priority"] == "5"`,
      `set(severity_number, SEVERITY_NUMBER_INFO)   where attributes["priority"] == "6"`,
      `set(severity_number, SEVERITY_NUMBER_DEBUG)  where attributes["priority"] == "7"`,

      `delete_matching_keys(attributes, "^(unit|syslog_identifier|host|priority|priority_keyword|loki\\.attribute\\.labels)$")`,
    ]
  }

  output {
    logs = [otelcol.processor.groupbyattrs.journal.input]
  }
}

// One resource per unit/host: moves service.name and host.name from the records to the resource
otelcol.processor.groupbyattrs "journal" {
  keys = ["service.name", "host.name"]
  output {
    logs = [otelcol.processor.batch.default.input]
  }
}

// ---------------- Traces (pg_tracing) ----------------
// pg_tracing's background worker posts OTLP/HTTP JSON here (pg_tracing.otel_endpoint).
// Not 4318: on the host network that port belongs to the central Alloy.
otelcol.receiver.otlp "pg_tracing" {
  http {
    endpoint = "127.0.0.1:14318"
  }
  output {
    traces = [otelcol.processor.transform.pg_tracing.input]
  }
}

otelcol.processor.transform "pg_tracing" {
  error_mode = "ignore"

  trace_statements {
    context = "resource"
    statements = [
      `set(attributes["db.system.name"], "postgresql")`,
    ]
  }

  output {
    traces = [otelcol.processor.batch.default.input]
  }
}

// ---------------- To the central Alloy ----------------
otelcol.processor.batch "default" {
  output {
    metrics = [otelcol.exporter.otlphttp.central.input]
    logs    = [otelcol.exporter.otlphttp.central.input]
    traces  = [otelcol.exporter.otlphttp.central.input]
  }
}

otelcol.exporter.otlphttp "central" {
  client {
    endpoint = "https://alloy.org"
    headers  = { "X-Scope-OrgID" = sys.env("TENANT") }
    tls {
      ca_file = "/etc/alloy-certs/ca.crt"   // self-signed root CA of the central Alloy
    }
  }
}

// ---------------- Profiles (eBPF) ----------------
// CPU profiles of the PostgreSQL processes, taken by the kernel (no agent in Postgres).
// Find the Postgres container by name via Docker, then its processes via /proc (pid: host).
discovery.docker "local" {
  host = "unix:///host/run/docker.sock"   // not /host/var/run: /var/run -> /run is an absolute symlink
  filter {
    name   = "name"
    values = ["^/" + sys.env("PG_CONTAINER") + "$"]
  }
}

// discovery.process joins external targets on __container_id__
discovery.relabel "pg_container" {
  targets = discovery.docker.local.targets
  rule {
    source_labels = ["__meta_docker_container_id"]
    target_label  = "__container_id__"
  }
}

discovery.process "pg" {
  join = discovery.relabel.pg_container.output
}

discovery.relabel "pg_processes" {
  targets = discovery.process.pg.targets
  // only processes of the joined container carry docker meta labels
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = ".+"
    action        = "keep"
  }
  rule {
    target_label = "service_name"
    replacement  = sys.env("SERVICE_NAME")
  }
}

pyroscope.ebpf "pg" {
  targets        = discovery.relabel.pg_processes.output
  forward_to     = [pyroscope.write.central.receiver]
  // Postgres is native code; the Python unwinder also fails the verifier on kernel 7.0
  python_enabled = false
}

pyroscope.write "central" {
  endpoint {
    url = "https://alloy.org"
    tls_config {
      ca_file = "/etc/alloy-certs/ca.crt"
    }
  }
  // The central Alloy routes profiles by this label (pyroscope.receive_http drops request headers)
  external_labels = { "tenant" = sys.env("TENANT") }
}
